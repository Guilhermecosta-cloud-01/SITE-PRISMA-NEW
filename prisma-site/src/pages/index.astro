---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BlocoRenderer from '../components/BlocoRenderer.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import CardCategoria from '../components/CardCategoria.astro';
import fotoHero from '../assets/hero/cozinha-profissional.webp';
import fotoCampinas from '../assets/campinas/imagemFundo.jpg';
import { aparencia } from '../lib/aparencia';

const mensagemHero = 'Olá! Gostaria de solicitar um orçamento de equipamentos para minha cozinha.';

const faixaDeConfianca = [
  { titulo: 'Marcas líderes de mercado', icone: 'escudo' },
  { titulo: 'Suporte técnico e comercial', icone: 'suporte' },
  { titulo: 'Agilidade na entrega (pós-venda)', icone: 'entrega' },
  { titulo: 'Atendimento a projetos e especificadores', icone: 'projetos' },
] as const;

// "Soluções por categoria" — mesma coleção `representadas`, deduplicada por
// `segmento` (1 card por necessidade, não por marca).
const solucoes = Array.from(
  new Map(
    (await getCollection('representadas', ({ data }) => data.ativa))
      .sort((a, b) => a.data.ordem - b.data.ordem)
      .map((r) => [r.data.segmento, r]),
  ).values(),
);

const segmentos = (await getCollection('segmentos', ({ data }) => data.ativa)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const iconeSegmento = (nome: string) => {
  const chave = nome.toLowerCase();
  if (chave.includes('restaurante')) return 'restaurante';
  if (chave.includes('hotel') || chave.includes('pousada')) return 'hotel';
  if (chave.includes('resort')) return 'resort';
  if (chave.includes('buffet') || chave.includes('evento')) return 'buffet';
  return 'generico';
};
---

<Layout
  title="Prisma Equipamentos — Soluções Integradas para Gastronomia"
  description="Representante autorizado Tramontina Hospitality no interior de São Paulo. Utensílios e equipamentos profissionais para restaurantes, bares, hotéis e cozinhas industriais."
>
  <!-- HERO -->
  <section class="relative bg-navy">
    <Image
      src={fotoHero}
      alt=""
      width={1600}
      height={900}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(90deg, rgba(27,53,86,0.94) 0%, rgba(27,53,86,0.82) 45%, rgba(27,53,86,0.55) 100%)"
    >
    </div>
    <div class="relative mx-auto max-w-[1440px] px-5 py-16 md:px-14 md:py-28">
      <div class="max-w-[600px]">
        <p
          class="font-mono text-[11px] font-medium uppercase tracking-[1.3px] text-areia/70 md:text-xs md:tracking-[1.6px]"
        >
          Representante autorizado Tramontina Food Service · Interior de SP
        </p>
        <h1
          class="mt-3.5 font-display text-[35px] leading-[1.12] text-areia md:mt-5 md:text-[58px] md:leading-[1.08]"
        >
          {aparencia.heroTitulo}
        </h1>
        <p class="mt-4 font-sans text-[15px] leading-relaxed text-areia/90 md:mt-6 md:max-w-[470px] md:text-lg">
          {aparencia.heroTexto}
        </p>
        <div class="mt-7 flex flex-col gap-3 md:mt-9 md:flex-row md:items-center">
          <BotaoWhatsApp mensagem={mensagemHero} texto="Solicitar Orçamento" class="w-full md:w-auto" />
          <a
            href="/representadas"
            class="inline-flex items-center justify-center rounded border border-aco px-6 py-3.5 font-sans text-[15.5px] font-semibold text-areia transition-colors hover:border-areia hover:bg-white/5"
          >
            Ver representadas
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAIXA DE CONFIANÇA -->
  <section class="border-b border-cinza/15 bg-papel px-5 py-8 md:px-14">
    <div class="mx-auto grid max-w-[1440px] grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
      {faixaDeConfianca.map((item) => (
        <div class="flex items-center gap-3">
          <svg
            width="30"
            height="30"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="shrink-0 text-[var(--color-accent)]"
          >
            {item.icone === 'escudo' && (
              <>
                <rect x="3" y="2" width="14" height="16" rx="3"></rect>
                <polyline points="7,10 9,12.5 13,7"></polyline>
              </>
            )}
            {item.icone === 'suporte' && (
              <>
                <rect x="2" y="3" width="16" height="11" rx="3"></rect>
                <path d="M6 14 L4 17 L4 14"></path>
              </>
            )}
            {item.icone === 'entrega' && (
              <>
                <rect x="2" y="6" width="10" height="8"></rect>
                <path d="M12 9h4l2 3v2h-6Z"></path>
                <circle cx="5.5" cy="16" r="1.5"></circle>
                <circle cx="14.5" cy="16" r="1.5"></circle>
              </>
            )}
            {item.icone === 'projetos' && (
              <>
                <rect x="4" y="2" width="12" height="16" rx="1"></rect>
                <line x1="7" y1="6" x2="13" y2="6"></line>
                <line x1="7" y1="9.5" x2="13" y2="9.5"></line>
                <line x1="7" y1="13" x2="11" y2="13"></line>
              </>
            )}
          </svg>
          <span class="font-sans text-[13.5px] font-semibold leading-snug text-navy md:text-sm">
            {item.titulo}
          </span>
        </div>
      ))}
    </div>
  </section>

  {aparencia.blocos.filter((bloco) => bloco.tipo === 'representadas').map((bloco) => <BlocoRenderer bloco={bloco} />)}

  <!-- SOLUÇÕES POR CATEGORIA -->
  <section class="bg-areia px-5 py-12 md:px-14 md:py-20">
    <div class="mx-auto max-w-[1440px]">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs md:tracking-[1.6px]">
        Soluções por categoria
      </p>
      <h2 class="mt-3 max-w-[680px] font-display text-[28px] leading-[1.15] text-navy md:mt-4 md:text-[42px]">
        Tudo o que o seu projeto precisa
      </h2>
      <p class="mt-3 max-w-xl font-sans text-[15px] leading-relaxed text-navy/80 md:text-base">
        Equipamentos e soluções completas para cozinhas profissionais, food service e indústrias — cada categoria
        atendida por uma marca representada.
      </p>

      <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-12 md:grid-cols-3 md:gap-6">
        {solucoes.map((representada) => (
          <CardCategoria
            titulo={representada.data.segmento}
            descricao={representada.data.descricaoCurta}
            href={representada.data.temCatalogoOnline ? `/${representada.id}` : `/representada/${representada.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SOLUÇÕES PARA TODOS OS SEGMENTOS -->
  <section class="bg-papel px-5 py-12 md:px-14 md:py-20">
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 items-center gap-10 md:grid-cols-[1fr_480px] md:gap-14">
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs md:tracking-[1.6px]">
          Segmentos atendidos
        </p>
        <h2 class="mt-3 font-display text-[28px] leading-[1.15] text-navy md:mt-4 md:text-[42px]">
          Soluções para todos os segmentos
        </h2>
        <p class="mt-3 max-w-md font-sans text-[15px] leading-relaxed text-aco md:text-base">
          Atendemos restaurantes, hotéis, resorts e operações de buffet e eventos em todo o interior de São Paulo,
          com suporte técnico e comercial para cada necessidade.
        </p>

        <div class="mt-7 grid grid-cols-2 gap-5 sm:grid-cols-4 md:mt-10 md:flex md:flex-wrap md:gap-8">
          {segmentos.map((segmento) => (
            <div class="flex flex-col items-center gap-2 text-center md:items-start md:text-left">
              <svg width="26" height="26" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--color-accent)]">
                {iconeSegmento(segmento.data.nome) === 'restaurante' && (
                  <>
                    <path d="M6 2v7a2 2 0 0 0 4 0V2"></path>
                    <line x1="8" y1="9" x2="8" y2="18"></line>
                    <path d="M14 2c-1.2 1-1.8 2.5-1.8 4.3 0 1.6 1 2.9 1.8 3.2V18"></path>
                  </>
                )}
                {iconeSegmento(segmento.data.nome) === 'hotel' && (
                  <>
                    <path d="M3 17V5a1 1 0 0 1 1-1h3v13"></path>
                    <path d="M7 10h9a1 1 0 0 1 1 1v6"></path>
                    <circle cx="9.5" cy="7.5" r="1"></circle>
                  </>
                )}
                {iconeSegmento(segmento.data.nome) === 'resort' && (
                  <>
                    <path d="M10 2c3 2 3 6 0 8-3-2-3-6 0-8Z"></path>
                    <path d="M10 10v8"></path>
                    <path d="M3 18c2-2 4-2 7 0s5 2 7 0"></path>
                  </>
                )}
                {iconeSegmento(segmento.data.nome) === 'buffet' && (
                  <>
                    <ellipse cx="10" cy="5" rx="7" ry="2"></ellipse>
                    <path d="M3 5v8c0 1.1 3.1 2 7 2s7-.9 7-2V5"></path>
                    <path d="M3 9c0 1.1 3.1 2 7 2s7-.9 7-2"></path>
                  </>
                )}
                {iconeSegmento(segmento.data.nome) === 'generico' && (
                  <rect x="3" y="3" width="14" height="14" rx="2"></rect>
                )}
              </svg>
              <span class="font-sans text-[13px] font-semibold leading-snug text-navy md:text-[13.5px]">
                {segmento.data.nome}
              </span>
            </div>
          ))}
        </div>
      </div>

      <div class="relative h-[260px] overflow-hidden rounded-md md:h-[420px]">
        <Image src={fotoCampinas} alt="Vista aérea de Campinas - SP" width={960} height={1080} class="h-full w-full object-cover" />
        <div class="absolute inset-0" style="background:linear-gradient(0deg, rgba(27,53,86,0.55) 0%, rgba(27,53,86,0) 35%)"></div>
        <span class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 rounded bg-navy/80 px-3 py-1.5 font-sans text-[12.5px] font-semibold text-papel">
          <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M10 18s6-5.5 6-10a6 6 0 1 0-12 0c0 4.5 6 10 6 10Z"></path>
            <circle cx="10" cy="8" r="2"></circle>
          </svg>
          Campinas - SP
        </span>
      </div>
    </div>
  </section>

  {aparencia.blocos.filter((bloco) => bloco.tipo === 'cta').map((bloco) => <BlocoRenderer bloco={bloco} />)}
</Layout>
