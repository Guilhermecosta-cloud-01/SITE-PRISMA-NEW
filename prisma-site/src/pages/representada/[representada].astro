---
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BotaoWhatsApp from '../../components/BotaoWhatsApp.astro';
import CardRepresentada from '../../components/CardRepresentada.astro';

export async function getStaticPaths() {
  const representadas = await getCollection(
    'representadas',
    ({ data }) => data.ativa && !data.temCatalogoOnline,
  );
  return representadas.map((representada) => ({
    params: { representada: representada.id },
    props: { representada },
  }));
}

const { representada } = Astro.props;
const { nome, segmento, descricaoCurta, nomeCatalogo, categoriasProdutos, imagens, diferenciais, logo } =
  representada.data;
const { Content } = await render(representada);

const segmentosAtendidos =
  representada.data.segmentosAtendidos.length > 0 ? await getEntries(representada.data.segmentosAtendidos) : [];

const outrasRepresentadas = (await getCollection('representadas', ({ data }) => data.ativa))
  .filter((r) => r.id !== representada.id)
  .sort((a, b) => a.data.ordem - b.data.ordem);

const mensagem = `Olá! Gostaria de receber o ${nomeCatalogo}.`;
---

<Layout title={`${nome} | Prisma Equipamentos`} description={descricaoCurta} image={logo}>
  <!-- 1. BANNER -->
  <section class="bg-navy px-5 py-12 md:px-14 md:py-16">
    <div class="mx-auto max-w-[1440px]">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-areia/70 md:text-xs">
        {segmento}
      </p>
      <h1 class="mt-3 max-w-2xl font-display text-[32px] leading-tight text-areia md:text-[46px]">{nome}</h1>
      <p class="mt-4 max-w-xl font-sans text-[15px] leading-relaxed text-areia/90 md:text-lg">{descricaoCurta}</p>
      <div class="mt-7">
        <BotaoWhatsApp mensagem={mensagem} texto="Solicitar catálogo no WhatsApp" class="w-full md:w-auto" />
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-5 py-10 md:px-14 md:py-16">
    <!-- 2. APRESENTAÇÃO -->
    <div class="prose font-sans text-[15px] leading-relaxed text-aco">
      <Content />
    </div>

    <!-- 3. PRINCIPAIS CATEGORIAS -->
    {categoriasProdutos.length > 0 && (
      <div class="mt-10">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">
          Principais categorias
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {categoriasProdutos.map((categoria) => (
            <li class="rounded border border-cinza/30 bg-papel px-3.5 py-1.5 font-sans text-sm text-navy">
              {categoria}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- 4. FOTOS REAIS -->
    {imagens.length > 0 && (
      <div class="mt-10">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">
          Produtos e aplicações
        </h2>
        <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3">
          {imagens.map((imagem) => (
            <Image
              src={imagem}
              alt={`${nome} — produto ou aplicação`}
              width={400}
              height={300}
              class="h-[140px] w-full rounded-md border border-cinza/30 object-cover md:h-[160px]"
            />
          ))}
        </div>
      </div>
    )}

    <!-- 5. DIFERENCIAIS -->
    {diferenciais.length > 0 && (
      <div class="mt-10">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">
          Benefícios e diferenciais
        </h2>
        <ul class="mt-3 flex flex-col gap-2">
          {diferenciais.map((item) => (
            <li class="flex items-start gap-2 font-sans text-[15px] text-navy">
              <svg width="13" height="10" viewBox="0 0 13 10" fill="none" aria-hidden="true" class="mt-1.5 shrink-0 text-verde">
                <path
                  d="M1 5.2 4.5 8.5 12 1"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- 6. SEGMENTOS E APLICAÇÕES COMPATÍVEIS -->
    {segmentosAtendidos.length > 0 && (
      <div class="mt-10">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">
          Segmentos atendidos
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {segmentosAtendidos.map((seg) => (
            <li class="rounded border border-cinza/30 bg-papel px-3.5 py-1.5 font-sans text-sm text-navy">
              {seg.data.nome}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- 7. CTA -->
    <div class="mt-10">
      <BotaoWhatsApp mensagem={mensagem} texto="Solicitar catálogo no WhatsApp" />
    </div>
  </div>

  <!-- 8. OUTRAS SOLUÇÕES RELACIONADAS -->
  {outrasRepresentadas.length > 0 && (
    <section class="bg-areia px-5 py-12 md:px-14 md:py-16">
      <div class="mx-auto max-w-[1440px]">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs">
          Outras soluções
        </p>
        <h2 class="mt-3 font-display text-2xl text-navy md:text-3xl">Outras marcas representadas</h2>
        <div class="mt-6 grid grid-cols-2 gap-3 md:mt-8 md:grid-cols-4 md:gap-6">
          {outrasRepresentadas.map((outra) => <CardRepresentada representada={outra} />)}
        </div>
      </div>
    </section>
  )}
</Layout>
