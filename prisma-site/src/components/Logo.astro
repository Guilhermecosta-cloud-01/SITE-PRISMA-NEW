---
import { Image } from 'astro:assets';
import logoHeader from '../assets/logo-header.png';

interface Props {
  height?: number;
}

const { height = 42 } = Astro.props;

// Proporção do arquivo oficial (ícone + "PRISMA EQUIPAMENTOS", sem a linha de
// tagline) — nunca distorça: largura sempre derivada da altura por esse aspect ratio.
const ASPECT = logoHeader.width / logoHeader.height;
const width = Math.round(height * ASPECT);
---

<Image
  src={logoHeader}
  alt="Prisma Equipamentos"
  width={width}
  height={height}
  format="png"
  style={`height:${height}px;width:${width}px`}
  class="shrink-0"
/>
