---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CardRepresentada from '../components/CardRepresentada.astro';

const representadas = (await getCollection('representadas', ({ data }) => data.ativa)).sort((a, b) =>
  a.data.segmento.localeCompare(b.data.segmento),
);
---

<Layout
  title="Soluções | Prisma Equipamentos"
  description="Soluções da Prisma Equipamentos por categoria: utensílios, fornos e cocção, refrigeração comercial, exaustão industrial, lavagem industrial e revestimentos."
>
  <div class="mx-auto max-w-[1440px] px-5 py-10 md:px-14 md:py-16">
    <h1 class="font-display text-[32px] leading-tight text-navy md:text-[46px]">Soluções por categoria</h1>
    <p class="mt-3 max-w-2xl font-sans text-[15px] leading-relaxed text-aco md:text-lg">
      Encontre a solução pela necessidade da sua operação — cada categoria é atendida por uma marca representada.
    </p>

    <div class="mt-8 grid grid-cols-2 gap-3 md:mt-12 md:grid-cols-4 md:gap-6">
      {representadas.map((representada) => <CardRepresentada representada={representada} />)}
    </div>
  </div>
</Layout>
