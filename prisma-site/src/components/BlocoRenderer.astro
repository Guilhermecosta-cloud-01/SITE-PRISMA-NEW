---
import { getCollection } from 'astro:content';
import type { Bloco, CorFundo } from '../lib/blocos';
import CardSegmento from './CardSegmento.astro';
import CardRepresentada from './CardRepresentada.astro';
import BotaoWhatsApp from './BotaoWhatsApp.astro';

interface Props {
  bloco: Bloco;
}

const { bloco } = Astro.props;

// Guia de cores: alterne fundo claro/escuro entre seções, nunca duas seções
// navy coladas (ver CLAUDE.md, seção "Guia de cores"). `papel` é o padrão de
// leitura, `areia` é o respiro de seção alternada, `navy` é a âncora escura
// (no máximo duas por página).
const fundos: Record<CorFundo, { secao: string; eyebrow: string; titulo: string; texto: string }> = {
  papel: { secao: 'bg-papel', eyebrow: 'text-cinza', titulo: 'text-navy', texto: 'text-aco' },
  areia: { secao: 'bg-areia', eyebrow: 'text-cinza', titulo: 'text-navy', texto: 'text-navy/80' },
  navy: { secao: 'bg-navy', eyebrow: 'text-areia/70', titulo: 'text-areia', texto: 'text-areia/90' },
};
const cor = fundos[bloco.corFundo];

const segmentos =
  bloco.tipo === 'segmentos'
    ? (await getCollection('segmentos', ({ data }) => data.ativa)).sort((a, b) => a.data.ordem - b.data.ordem)
    : [];

const representadas =
  bloco.tipo === 'representadas'
    ? (await getCollection('representadas', ({ data }) => data.ativa)).sort((a, b) => a.data.ordem - b.data.ordem)
    : [];

// "Soluções por categoria" reaproveita a mesma coleção `representadas`, só que
// agrupada por `segmento` (1 card por categoria/necessidade, não por marca) —
// como cada marca hoje cobre um segmento só, isso vira 1 card por marca mesmo,
// mas com outro enquadramento (por necessidade do cliente, não por nome de marca).
const solucoes =
  bloco.tipo === 'solucoes'
    ? Array.from(
        new Map(
          (await getCollection('representadas', ({ data }) => data.ativa))
            .sort((a, b) => a.data.ordem - b.data.ordem)
            .map((r) => [r.data.segmento, r]),
        ).values(),
      )
    : [];

const cidadesAtivas =
  bloco.tipo === 'cidades'
    ? (await getCollection('cidades', ({ data }) => data.ativa)).sort((a, b) =>
        a.data.nome.localeCompare(b.data.nome),
      )
    : [];

// Guarda defensiva: um bloco sem conteúdo de verdade (grid vazio, cards sem
// itens, CTA sem destino) não deve virar uma seção quebrada/vazia no ar —
// isso já aconteceu com dado de teste editado direto pelo Keystatic.
const temConteudo = (() => {
  switch (bloco.tipo) {
    case 'segmentos':
      return segmentos.length > 0;
    case 'representadas':
      return representadas.length > 0;
    case 'solucoes':
      return solucoes.length > 0;
    case 'cidades':
      return cidadesAtivas.length > 0;
    case 'cards':
      return bloco.itens.length > 0;
    case 'cta':
      return Boolean(bloco.botaoMensagemWhatsapp || bloco.botaoLink);
    default:
      return true;
  }
})();
---

{temConteudo && (
<section class={`${cor.secao} px-5 py-12 md:px-14 md:py-20`}>
  <div class="mx-auto max-w-[1440px]">
    {bloco.subtitulo && (
      <p class={`font-mono text-[11px] font-semibold uppercase tracking-[1.2px] md:text-xs md:tracking-[1.6px] ${cor.eyebrow}`}>
        {bloco.subtitulo}
      </p>
    )}
    <h2 class={`mt-3 max-w-[680px] font-display text-[28px] leading-[1.15] md:mt-4 md:text-[42px] ${cor.titulo}`}>
      {bloco.titulo}
    </h2>

    {bloco.tipo === 'segmentos' && (
      <div class="mt-7 flex flex-col gap-3 md:mt-12 md:flex-row md:gap-5">
        {segmentos.map((segmento) => <CardSegmento segmento={segmento} />)}
      </div>
    )}

    {bloco.tipo === 'representadas' && (
      <div class="mt-6 grid grid-cols-2 gap-3 md:mt-12 md:grid-cols-4 md:gap-6">
        {representadas.map((representada) => <CardRepresentada representada={representada} />)}
      </div>
    )}

    {bloco.tipo === 'solucoes' && (
      <>
        <div class="mt-6 grid grid-cols-2 gap-3 md:mt-12 md:grid-cols-3 md:gap-6">
          {solucoes.map((representada) => <CardRepresentada representada={representada} />)}
        </div>
        <a
          href="/solucoes"
          class={`mt-6 inline-flex items-center gap-1.5 font-sans text-sm font-semibold md:mt-8 ${bloco.corFundo === 'navy' ? 'text-areia' : 'text-navy'} hover:text-[var(--color-accent)] transition-colors`}
        >
          Ver todas as soluções →
        </a>
      </>
    )}

    {bloco.tipo === 'cidades' && (
      <>
        <ul class="mt-6 flex flex-wrap gap-3 md:mt-10">
          {cidadesAtivas.map((cidade) => (
            <li>
              <a
                href={`/${cidade.id}`}
                class="inline-flex items-center gap-2 rounded border border-cinza/30 bg-papel px-5 py-3 font-sans text-[15px] font-semibold text-navy transition-colors hover:border-[var(--color-accent)]"
              >
                {cidade.data.nome} - {cidade.data.estado}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/area-de-atendimento"
          class={`mt-6 inline-flex items-center gap-1.5 font-sans text-sm font-semibold md:mt-8 ${bloco.corFundo === 'navy' ? 'text-areia' : 'text-navy'} hover:text-[var(--color-accent)] transition-colors`}
        >
          Ver área de atendimento completa →
        </a>
      </>
    )}

    {bloco.tipo === 'cards' && (
      <div class="mt-7 flex flex-col md:mt-14 md:flex-row">
        {bloco.itens.map((item, i) => (
          <div
            class:list={[
              'flex flex-col gap-2 py-5 md:gap-3.5 md:py-0',
              i === 0 ? 'md:pr-7' : 'border-t border-cinza/25 md:border-t-0 md:border-l md:px-7',
              i === bloco.itens.length - 1 && 'md:pl-7 md:pr-0',
            ]}
          >
            <h3 class={`font-sans text-[15.5px] font-bold md:text-lg ${cor.titulo}`}>{item.titulo}</h3>
            <p class={`font-sans text-sm leading-relaxed ${cor.texto}`}>{item.descricao}</p>
          </div>
        ))}
      </div>
    )}

    {bloco.tipo === 'cta' && (
      <div class="mt-5 flex flex-col items-start gap-5 md:mt-7 md:flex-row md:items-end md:justify-between">
        <p class={`max-w-xl font-sans text-sm leading-relaxed md:text-[15.5px] ${cor.texto}`}>{bloco.texto}</p>
        {bloco.botaoMensagemWhatsapp ? (
          <BotaoWhatsApp mensagem={bloco.botaoMensagemWhatsapp} texto={bloco.botaoTexto} class="w-full md:w-auto" />
        ) : bloco.botaoLink ? (
          <a
            href={bloco.botaoLink}
            class="inline-flex w-full items-center justify-center rounded bg-[var(--color-accent-cta)] px-6 py-3.5 font-sans text-[15px] font-semibold text-papel transition-colors hover:bg-[var(--color-accent-cta-hover)] md:w-auto"
          >
            {bloco.botaoTexto}
          </a>
        ) : null}
      </div>
    )}
  </div>
</section>
)}
