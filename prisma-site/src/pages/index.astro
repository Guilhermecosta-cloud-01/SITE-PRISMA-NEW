---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BlocoRenderer from '../components/BlocoRenderer.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import logoIcon from '../assets/logo-icon.png';
import { aparencia } from '../lib/aparencia';

const representadas = (await getCollection('representadas', ({ data }) => data.ativa)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const mensagemHero = 'Olá! Gostaria de falar sobre equipamentos para minha cozinha.';

const marcadores = ['bg-aco', 'bg-areia', 'bg-[var(--color-accent)]'];
---

<Layout
  title="Prisma Equipamentos — Soluções Integradas para Gastronomia"
  description="Representante autorizado Tramontina Hospitality no interior de São Paulo. Utensílios e equipamentos profissionais para restaurantes, bares, hotéis e cozinhas industriais."
>
  <!-- HERO -->
  <section class="bg-navy">
    <div
      class="mx-auto flex max-w-[1440px] flex-col gap-10 px-5 pb-14 pt-4 md:flex-row md:items-center md:gap-[70px] md:px-14 md:pb-16 md:pt-6"
    >
      <div class="flex-1 md:max-w-[600px]">
        <p
          class="font-mono text-[11px] font-medium uppercase tracking-[1.3px] text-areia/70 md:text-xs md:tracking-[1.6px]"
        >
          Representante autorizado Tramontina Food Service · Interior de SP
        </p>
        <h1
          class="mt-3.5 font-display text-[35px] leading-[1.12] text-areia md:mt-5 md:text-[58px] md:leading-[1.08]"
        >
          {aparencia.heroTitulo}
        </h1>
        <p class="mt-4 font-sans text-[15px] leading-relaxed text-areia/90 md:mt-6 md:max-w-[470px] md:text-lg">
          {aparencia.heroTexto}
        </p>
        <div class="mt-7 flex flex-col gap-3 md:mt-9 md:flex-row md:items-center">
          <BotaoWhatsApp mensagem={mensagemHero} texto="Pedir orçamento no WhatsApp" class="w-full md:w-auto" />
          <a
            href="/representadas"
            class="inline-flex items-center justify-center rounded border border-aco px-6 py-3.5 font-sans text-[15.5px] font-semibold text-areia transition-colors hover:border-areia hover:bg-white/5"
          >
            Ver representadas
          </a>
        </div>
      </div>

      <div class="flex-1 md:max-w-[520px]">
        <div class="relative overflow-hidden rounded-md border border-white/8 bg-navy p-6 md:p-9">
          <div
            class="pointer-events-none absolute inset-0"
            style="background:repeating-linear-gradient(115deg,rgba(255,255,255,.035) 0px,rgba(255,255,255,.035) 2px,transparent 2px,transparent 26px)"
          >
          </div>
          <div class="relative mb-[18px] flex items-center md:mb-[30px]">
            <div
              class="h-0.5 flex-1 origin-left"
              style="background:linear-gradient(90deg,transparent,#D4703A 85%,#D4703A);transform:scaleX(0);animation:prisma-beam 700ms ease-out 200ms forwards"
            >
            </div>
            <div
              class="h-[34px] w-8 shrink-0 md:h-[42px] md:w-10"
              style="animation:prisma-flash 700ms ease-out 550ms forwards"
            >
              <Image src={logoIcon} alt="" width={42} height={42} class="h-full w-full object-contain" />
            </div>
          </div>
          <ul class="relative flex flex-col">
            {representadas.map((representada, i) => (
              <li
                class="flex items-center gap-3.5 border-b border-white/8 py-3 opacity-0 last:border-b-0"
                style={`animation:prisma-chip-in 480ms ease-out ${700 + i * 85}ms forwards`}
              >
                <span class={`h-[18px] w-[3px] shrink-0 ${marcadores[i % 3]}`}></span>
                <span class="font-sans text-[15.5px] text-areia">{representada.data.nome}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {aparencia.blocos.map((bloco) => <BlocoRenderer bloco={bloco} />)}
</Layout>
