---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BotaoWhatsApp from '../../components/BotaoWhatsApp.astro';

export async function getStaticPaths() {
  const produtos = await getCollection('produtos');
  return produtos.map((produto) => ({
    params: { produto: produto.id },
    props: { produto },
  }));
}

const { produto } = Astro.props;
const { nome, imagem, specs, aplicacao, categoria } = produto.data;
const { Content } = await render(produto);

const categoriaEntry = await getEntry(categoria);

const mensagem = `Olá! Vi a ${nome} no site e queria consultar o preço.`;
---

<Layout title={`${nome} | Prisma Equipamentos`} description={aplicacao}>
  <div class="mx-auto max-w-3xl px-5 py-10 md:px-14 md:py-16">
    <Image
      src={imagem}
      alt={nome}
      width={800}
      height={600}
      class="w-full rounded-md border border-cream-border object-cover"
    />

    <h1 class="mt-6 font-display text-[32px] leading-tight text-navy-800 md:text-[42px]">{nome}</h1>

    {categoriaEntry && (
      <p class="mt-2 font-sans text-sm text-[#5C6B7A]">
        Categoria:{' '}
        <a href={`/categoria/${categoriaEntry.id}`} class="font-semibold text-[var(--color-accent)]">
          {categoriaEntry.data.nome}
        </a>
      </p>
    )}

    <h2 class="mt-7 font-mono text-xs font-semibold uppercase tracking-[1.2px] text-[#6B7F94]">
      Especificações
    </h2>
    <ul class="mt-3 flex flex-col gap-1.5 font-sans text-[15px] text-navy-800">
      {specs.map((spec) => <li>· {spec}</li>)}
    </ul>

    <h2 class="mt-7 font-mono text-xs font-semibold uppercase tracking-[1.2px] text-[#6B7F94]">
      Aplicação
    </h2>
    <p class="mt-3 font-sans text-[15px] leading-relaxed text-[#5C6B7A]">{aplicacao}</p>

    <div class="prose mt-6 font-sans text-[15px] leading-relaxed text-[#5C6B7A]">
      <Content />
    </div>

    <div class="mt-8">
      <BotaoWhatsApp mensagem={mensagem} />
    </div>
  </div>
</Layout>
