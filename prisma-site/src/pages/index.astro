---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BlocoRenderer from '../components/BlocoRenderer.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import fotoHero from '../assets/hero/cozinha-profissional.webp';
import { aparencia } from '../lib/aparencia';

const mensagemHero = 'Olá! Gostaria de solicitar um orçamento de equipamentos para minha cozinha.';

const faixaDeConfianca = [
  { titulo: 'Marcas líderes de mercado', icone: 'escudo' },
  { titulo: 'Suporte técnico e comercial', icone: 'suporte' },
  { titulo: 'Agilidade na entrega (pós-venda)', icone: 'entrega' },
  { titulo: 'Atendimento a projetos e especificadores', icone: 'projetos' },
] as const;
---

<Layout
  title="Prisma Equipamentos — Soluções Integradas para Gastronomia"
  description="Representante autorizado Tramontina Hospitality no interior de São Paulo. Utensílios e equipamentos profissionais para restaurantes, bares, hotéis e cozinhas industriais."
>
  <!-- HERO -->
  <section class="relative bg-navy">
    <Image
      src={fotoHero}
      alt=""
      width={1600}
      height={900}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(90deg, rgba(27,53,86,0.94) 0%, rgba(27,53,86,0.82) 45%, rgba(27,53,86,0.55) 100%)"
    >
    </div>
    <div class="relative mx-auto max-w-[1440px] px-5 py-16 md:px-14 md:py-28">
      <div class="max-w-[600px]">
        <p
          class="font-mono text-[11px] font-medium uppercase tracking-[1.3px] text-areia/70 md:text-xs md:tracking-[1.6px]"
        >
          Representante autorizado Tramontina Food Service · Interior de SP
        </p>
        <h1
          class="mt-3.5 font-display text-[35px] leading-[1.12] text-areia md:mt-5 md:text-[58px] md:leading-[1.08]"
        >
          {aparencia.heroTitulo}
        </h1>
        <p class="mt-4 font-sans text-[15px] leading-relaxed text-areia/90 md:mt-6 md:max-w-[470px] md:text-lg">
          {aparencia.heroTexto}
        </p>
        <div class="mt-7 flex flex-col gap-3 md:mt-9 md:flex-row md:items-center">
          <BotaoWhatsApp mensagem={mensagemHero} texto="Solicitar Orçamento" class="w-full md:w-auto" />
          <a
            href="/representadas"
            class="inline-flex items-center justify-center rounded border border-aco px-6 py-3.5 font-sans text-[15.5px] font-semibold text-areia transition-colors hover:border-areia hover:bg-white/5"
          >
            Ver representadas
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAIXA DE CONFIANÇA -->
  <section class="border-b border-cinza/15 bg-papel px-5 py-8 md:px-14">
    <div class="mx-auto grid max-w-[1440px] grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
      {faixaDeConfianca.map((item) => (
        <div class="flex items-center gap-3">
          <svg
            width="30"
            height="30"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="shrink-0 text-[var(--color-accent)]"
          >
            {item.icone === 'escudo' && (
              <>
                <rect x="3" y="2" width="14" height="16" rx="3"></rect>
                <polyline points="7,10 9,12.5 13,7"></polyline>
              </>
            )}
            {item.icone === 'suporte' && (
              <>
                <rect x="2" y="3" width="16" height="11" rx="3"></rect>
                <path d="M6 14 L4 17 L4 14"></path>
              </>
            )}
            {item.icone === 'entrega' && (
              <>
                <rect x="2" y="6" width="10" height="8"></rect>
                <path d="M12 9h4l2 3v2h-6Z"></path>
                <circle cx="5.5" cy="16" r="1.5"></circle>
                <circle cx="14.5" cy="16" r="1.5"></circle>
              </>
            )}
            {item.icone === 'projetos' && (
              <>
                <rect x="4" y="2" width="12" height="16" rx="1"></rect>
                <line x1="7" y1="6" x2="13" y2="6"></line>
                <line x1="7" y1="9.5" x2="13" y2="9.5"></line>
                <line x1="7" y1="13" x2="11" y2="13"></line>
              </>
            )}
          </svg>
          <span class="font-sans text-[13.5px] font-semibold leading-snug text-navy md:text-sm">
            {item.titulo}
          </span>
        </div>
      ))}
    </div>
  </section>

  {aparencia.blocos.map((bloco) => <BlocoRenderer bloco={bloco} />)}
</Layout>
