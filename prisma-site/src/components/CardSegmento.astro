---
import type { CollectionEntry } from 'astro:content';

interface Props {
  segmento: CollectionEntry<'segmentos'>;
}

const { segmento } = Astro.props;
const { nome, descricao } = segmento.data;
---

<div class="flex-1 rounded-md border border-cinza/30 bg-papel p-5 md:p-8">
  <h3 class="font-sans text-[16.5px] font-bold text-navy md:text-[19px]">{nome}</h3>
  <p class="mt-2 font-sans text-sm leading-relaxed text-aco md:mt-3.5">{descricao}</p>
</div>
