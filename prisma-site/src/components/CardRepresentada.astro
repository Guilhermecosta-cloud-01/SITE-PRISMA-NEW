---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  representada: CollectionEntry<'representadas'>;
}

const { representada } = Astro.props;
const { nome, segmento, descricaoCurta, logo, temCatalogoOnline } = representada.data;

const href = temCatalogoOnline ? `/${representada.id}` : `/representada/${representada.id}`;
---

<a
  href={href}
  class="flex flex-col overflow-hidden rounded-md border border-cream-border bg-white"
>
  <div class="flex h-[90px] items-center justify-center border-b border-cream-border bg-cream px-6 md:h-[110px]">
    {logo ? (
      <Image src={logo} alt={nome} width={160} height={64} class="max-h-full max-w-full object-contain" />
    ) : (
      <span class="font-display text-2xl text-navy-800 md:text-3xl">{nome}</span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-4 md:p-5">
    <span class="font-mono text-[10.5px] font-semibold uppercase tracking-[1.2px] text-[var(--color-accent)] md:text-[11px]">
      {segmento}
    </span>
    <span class="font-sans text-[13.5px] font-bold text-navy-800 md:text-[16px]">{nome}</span>
    <p class="font-sans text-[12.5px] leading-snug text-[#5C6B7A] md:text-sm">{descricaoCurta}</p>
  </div>
</a>
