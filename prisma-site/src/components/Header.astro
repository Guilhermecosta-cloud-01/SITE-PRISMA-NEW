---
import Logo from './Logo.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import { linkWhatsApp } from '../lib/whatsapp';

const mensagem = 'Olá! Gostaria de falar sobre equipamentos para minha cozinha.';

const links = [
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/#segmentos', label: 'Segmentos' },
  { href: '/#area-de-atendimento', label: 'Área de atendimento' },
  { href: '/sobre', label: 'Sobre' },
];
---

<header class="relative bg-navy-800">
  <div class="max-w-[1440px] mx-auto flex items-center justify-between px-5 py-4 md:px-14 md:py-6">
    <a href="/" aria-label="Prisma Equipamentos — início">
      <span class="md:hidden">
        <Logo iconSize={34} textSize={18} showTagline={false} />
      </span>
      <span class="hidden md:inline-flex">
        <Logo iconSize={46} textSize={23} />
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-sans text-[14.5px] text-[#C3D1DD] hover:text-cream transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href={linkWhatsApp(mensagem)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded border border-navy-600 px-5 py-2.5 font-sans text-sm font-semibold text-cream hover:bg-white/5 hover:border-cream transition-colors"
      >
        <IconWhatsApp size={16} />
        Falar no WhatsApp
      </a>
    </nav>

    <details class="md:hidden group">
      <summary class="list-none p-3.5 -m-3.5 flex items-center cursor-pointer">
        <svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true">
          <rect width="22" height="2" fill="#C3D1DD"></rect>
          <rect y="6" width="22" height="2" fill="#C3D1DD"></rect>
          <rect y="12" width="22" height="2" fill="#C3D1DD"></rect>
        </svg>
        <span class="sr-only">Menu</span>
      </summary>
      <nav class="absolute inset-x-0 top-full flex flex-col gap-1 border-t border-white/10 bg-navy-800 px-5 pb-5 pt-3 shadow-lg">
        {links.map((link) => (
          <a
            href={link.href}
            class="font-sans text-[15px] text-[#C3D1DD] py-2"
          >
            {link.label}
          </a>
        ))}
        <a
          href={linkWhatsApp(mensagem)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center justify-center gap-2 rounded border border-navy-600 px-5 py-2.5 font-sans text-sm font-semibold text-cream"
        >
          <IconWhatsApp size={16} />
          Falar no WhatsApp
        </a>
      </nav>
    </details>
  </div>
</header>
