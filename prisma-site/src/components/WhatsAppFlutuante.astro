---
import IconWhatsApp from './IconWhatsApp.astro';
import { linkWhatsApp } from '../lib/whatsapp';

const mensagem = 'Olá! Gostaria de falar sobre equipamentos para minha cozinha.';
---

<a
  href={linkWhatsApp(mensagem)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
  class="fixed bottom-4 right-4 z-50 flex h-13 w-13 items-center justify-center rounded-full bg-[var(--color-accent-cta)] text-papel shadow-[0_8px_20px_rgba(0,0,0,0.35)] transition-colors hover:bg-[var(--color-accent-cta-hover)]"
>
  <IconWhatsApp size={23} />
</a>
