---
import Logo from './Logo.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import { linkWhatsApp } from '../lib/whatsapp';

const mensagem = 'Olá! Gostaria de falar sobre equipamentos para minha cozinha.';

const links = [
  { href: '/', label: 'Início' },
  { href: '/representadas', label: 'Marcas' },
  { href: '/solucoes', label: 'Soluções' },
  { href: '/segmentos', label: 'Segmentos' },
  { href: '/area-de-atendimento', label: 'Atendimento regional' },
  { href: '/contato', label: 'Contato' },
];

const caminhoAtual = Astro.url.pathname;
const estaAtivo = (href: string) => (href === '/' ? caminhoAtual === '/' : caminhoAtual.startsWith(href));
---

<header class="sticky top-0 z-50 bg-marinho shadow-[0_1px_0_rgba(255,255,255,0.08)]">
  <div class="max-w-[1440px] mx-auto flex items-center justify-between px-5 py-4 md:px-14 md:py-5">
    <a href="/" aria-label="Prisma Equipamentos — início">
      <span class="md:hidden">
        <Logo height={32} />
      </span>
      <span class="hidden md:inline-flex">
        <Logo height={40} />
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'relative pb-1 font-sans text-[14.5px] transition-colors',
            estaAtivo(link.href)
              ? 'text-papel after:absolute after:inset-x-0 after:-bottom-[1px] after:h-[2px] after:bg-[var(--color-accent)]'
              : 'text-areia/75 hover:text-papel',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={linkWhatsApp(mensagem)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded bg-whatsapp px-5 py-2.5 font-sans text-sm font-semibold text-papel shadow-sm transition-colors hover:bg-whatsapp-hover"
      >
        <IconWhatsApp size={16} />
        Fale conosco
      </a>
    </nav>

    <details class="md:hidden group">
      <summary class="list-none p-3.5 -m-3.5 flex items-center cursor-pointer">
        <svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true">
          <rect width="22" height="2" fill="#FBFAF8"></rect>
          <rect y="6" width="22" height="2" fill="#FBFAF8"></rect>
          <rect y="12" width="22" height="2" fill="#FBFAF8"></rect>
        </svg>
        <span class="sr-only">Menu</span>
      </summary>
      <nav class="absolute inset-x-0 top-full flex flex-col gap-1 border-t border-white/10 bg-marinho px-5 pb-5 pt-3 shadow-lg">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'font-sans text-[15px] py-2',
              estaAtivo(link.href) ? 'text-papel font-semibold' : 'text-areia/80',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href={linkWhatsApp(mensagem)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center justify-center gap-2 rounded bg-whatsapp px-5 py-2.5 font-sans text-sm font-semibold text-papel"
        >
          <IconWhatsApp size={16} />
          Fale conosco
        </a>
      </nav>
    </details>
  </div>
</header>
