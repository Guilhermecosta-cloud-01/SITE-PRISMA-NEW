---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  representada: CollectionEntry<'representadas'>;
}

const { representada } = Astro.props;
const { nome, segmento, logo, temCatalogoOnline } = representada.data;

const href = temCatalogoOnline ? `/${representada.id}` : `/representada/${representada.id}`;
---

<a href={href} class="group flex flex-col items-center gap-2.5 transition-opacity hover:opacity-80">
  <div class="flex h-[52px] items-center justify-center md:h-[60px]">
    {logo ? (
      <Image src={logo} alt={nome} width={150} height={60} class="max-h-full max-w-full object-contain" />
    ) : (
      <span class="font-display text-xl text-navy md:text-2xl">{nome}</span>
    )}
  </div>
  <span class="font-sans text-[12px] font-medium text-aco md:text-[13px]">{segmento}</span>
</a>
