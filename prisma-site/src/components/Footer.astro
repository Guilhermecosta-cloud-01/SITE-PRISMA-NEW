---
import Logo from './Logo.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import { linkWhatsApp } from '../lib/whatsapp';
import { aparencia } from '../lib/aparencia';

const mensagem = 'Olá! Gostaria de falar sobre equipamentos para minha cozinha.';

const navLinks = [
  { href: '/representadas', label: 'Representadas' },
  { href: '/area-de-atendimento', label: 'Área de atendimento' },
  { href: '/sobre', label: 'Sobre' },
];
---

<footer class="bg-navy-900">
  <div class="max-w-[1440px] mx-auto px-5 py-10 md:px-14 md:py-16">
    <div class="flex flex-col gap-8 pb-8 md:flex-row md:flex-wrap md:justify-between md:gap-10 md:pb-10">
      <div class="flex max-w-[260px] flex-col gap-3">
        <span class="md:hidden">
          <Logo iconSize={30} textSize={16} showTagline={false} />
        </span>
        <span class="hidden md:inline-flex">
          <Logo iconSize={34} textSize={18} showTagline={false} />
        </span>
        <p class="font-sans text-[13.5px] leading-relaxed text-[#8FA8C1]">
          Equipamentos profissionais para cozinhas de alto desempenho.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-[#5E7B99] md:text-[11.5px]">
          Navegação
        </span>
        {navLinks.map((link) => (
          <a href={link.href} class="font-sans text-sm text-[#C3D1DD] hover:text-cream transition-colors">
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-[#5E7B99] md:text-[11.5px]">
          Contato
        </span>
        <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener noreferrer" class="font-sans text-sm text-[#C3D1DD] hover:text-cream transition-colors">
          (19) 99261-6207
        </a>
        <span class="font-sans text-sm text-[#C3D1DD]">TODO: e-mail real de contato</span>
        <span class="font-sans text-sm text-[#C3D1DD]">Interior de SP</span>
      </div>

      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-[#5E7B99] md:text-[11.5px]">
          Redes
        </span>
        <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 font-sans text-sm text-[#C3D1DD] hover:text-cream transition-colors">
          <IconWhatsApp size={15} />
          WhatsApp
        </a>
        <span class="flex items-center gap-2 font-sans text-sm text-[#C3D1DD]" title="TODO: link do Instagram">
          <svg width="15" height="15" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="16" height="16" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
            <circle cx="9" cy="9" r="4" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="14" cy="4" r="1" fill="currentColor"></circle>
          </svg>
          Instagram
        </span>
      </div>
    </div>

    <div class="flex flex-col gap-1.5 border-t border-white/8 pt-5 md:flex-row md:items-center md:justify-between md:pt-6">
      <span class="font-mono text-[11px] text-[#5E7B99] md:text-xs">© 2026 Prisma Equipamentos</span>
      <span class="font-mono text-[11px] text-[#5E7B99] md:text-xs">Representante autorizado Tramontina Food Service</span>
    </div>

    <p class="mt-4 font-sans text-xs text-[#5E7B99]">
      {aparencia.textoRodapeExtra && <span>{aparencia.textoRodapeExtra} · </span>}
      <a href="/privacidade" class="hover:text-cream transition-colors">Política de Privacidade</a>
    </p>
  </div>
</footer>
