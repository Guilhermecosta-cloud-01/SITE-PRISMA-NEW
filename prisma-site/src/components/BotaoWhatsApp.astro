---
import IconWhatsApp from './IconWhatsApp.astro';
import { linkWhatsApp } from '../lib/whatsapp';

interface Props {
  mensagem: string;
  texto?: string;
  icone?: boolean;
  variante?: 'primario' | 'contorno';
  class?: string;
}

const {
  mensagem,
  texto = 'Consultar preço',
  icone = true,
  variante = 'primario',
  class: className = '',
} = Astro.props;

const estilos =
  variante === 'primario'
    ? 'bg-[var(--color-accent-cta)] text-papel hover:bg-[var(--color-accent-cta-hover)]'
    : 'border border-navy text-navy hover:bg-navy/5';
---

<a
  href={linkWhatsApp(mensagem)}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center justify-center gap-2 rounded font-sans text-[15px] font-semibold px-6 py-3.5 transition-colors ${estilos} ${className}`}
>
  {icone && <IconWhatsApp size={17} />}
  {texto}
</a>
