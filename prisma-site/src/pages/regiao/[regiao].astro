---
import { getCollection, getEntries, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BotaoWhatsApp from '../../components/BotaoWhatsApp.astro';

export async function getStaticPaths() {
  const regioes = await getCollection('regioes', ({ data }) => data.ativa);
  return regioes.map((regiao) => ({
    params: { regiao: regiao.id },
    props: { regiao },
  }));
}

const { regiao } = Astro.props;
const { nome } = regiao.data;
const { Content } = await render(regiao);

const cidades = (await getEntries(regiao.data.cidades))
  .filter((cidade) => cidade.data.ativa)
  .sort((a, b) => a.data.nome.localeCompare(b.data.nome));

const mensagem = `Olá! Sou da região de ${nome} e gostaria de um orçamento de equipamentos para cozinha.`;
---

<Layout title={regiao.data.metaTitle} description={regiao.data.metaDescription}>
  <section class="bg-navy px-5 py-12 md:px-14 md:py-16">
    <div class="mx-auto max-w-[1440px]">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-areia/70 md:text-xs">
        Área de atendimento
      </p>
      <h1 class="mt-3 max-w-2xl font-display text-[32px] leading-tight text-areia md:text-[46px]">
        Equipamentos para cozinha profissional na {nome}
      </h1>
      <div class="prose mt-5 max-w-2xl font-sans text-[15px] leading-relaxed text-areia/90 md:text-lg">
        <Content />
      </div>
      <div class="mt-8">
        <BotaoWhatsApp mensagem={mensagem} texto="Pedir orçamento no WhatsApp" class="w-full md:w-auto" />
      </div>
    </div>
  </section>

  {cidades.length > 0 && (
    <section class="bg-papel px-5 py-12 md:px-14 md:py-16">
      <div class="mx-auto max-w-[1440px]">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs">
          Cidades atendidas nessa região
        </p>
        <ul class="mt-6 flex flex-wrap gap-3 md:mt-10">
          {cidades.map((cidade) => (
            <li>
              <a
                href={`/${cidade.id}`}
                class="inline-flex items-center gap-2 rounded border border-cinza/30 bg-papel px-5 py-3 font-sans text-[15px] font-semibold text-navy transition-colors hover:border-[var(--color-accent)]"
              >
                {cidade.data.nome} - {cidade.data.estado}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>
