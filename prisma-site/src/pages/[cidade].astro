---
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CardProduto from '../components/CardProduto.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import BlocoRenderer from '../components/BlocoRenderer.astro';
import { paraBlocos } from '../lib/blocos';
import { linkWhatsApp } from '../lib/whatsapp';

export async function getStaticPaths() {
  const cidades = await getCollection('cidades', ({ data }) => data.ativa);
  return cidades.map((cidade) => ({
    params: { cidade: cidade.id },
    props: { cidade },
  }));
}

const { cidade } = Astro.props;
const { nome } = cidade.data;
const { Content } = await render(cidade);

const categorias = (await getCollection('categorias')).sort((a, b) => a.data.ordem - b.data.ordem);

const produtosDestaqueCidade =
  cidade.data.produtosDestaque.length > 0 ? await getEntries(cidade.data.produtosDestaque) : [];

const produtosDestaque =
  produtosDestaqueCidade.length > 0
    ? produtosDestaqueCidade
    : (await getCollection('produtos')).filter((produto) => produto.data.destaque).sort((a, b) => a.data.ordem - b.data.ordem);

const outrasCidades = (await getCollection('cidades'))
  .filter((c) => c.data.ativa && c.id !== cidade.id)
  .sort((a, b) => a.data.nome.localeCompare(b.data.nome));

const temProvaSocial = Boolean(cidade.data.depoimentoTexto);
const blocos = paraBlocos(cidade.data.blocos);

const mensagemHeroPrimaria = `Olá! Sou de ${nome} e gostaria de um orçamento de equipamentos para cozinha.`;
const mensagemHeroSecundaria = `Olá! Sou de ${nome} e gostaria de receber o catálogo da Prisma.`;
const mensagemCtaFinal = `Olá! Sou de ${nome} e quero equipar minha cozinha.`;

function mensagemCategoria(nomeCategoria: string) {
  return `Olá! Sou de ${nome} e queria ver as opções de ${nomeCategoria}.`;
}

const comoFunciona = [
  {
    numero: '1',
    titulo: 'Fale no WhatsApp',
    descricao: 'Conte o que sua cozinha precisa — equipamento novo, reposição ou um projeto completo.',
  },
  {
    numero: '2',
    titulo: 'Receba o orçamento',
    descricao: 'Você recebe uma proposta personalizada, sem compromisso e sem preço publicado no site.',
  },
  {
    numero: '3',
    titulo: 'Entrega e pós-venda',
    descricao: 'Equipamento entregue com garantia de fábrica e suporte para o que precisar depois.',
  },
];
---

<Layout title={cidade.data.metaTitle} description={cidade.data.metaDescription}>
  <!-- 1. HERO (âncora navy 1/2) -->
  <section class="bg-navy">
    <div class="mx-auto max-w-[1440px] px-5 pb-12 pt-8 md:px-14 md:pb-16 md:pt-12">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-areia/70 md:text-xs">
        Atendimento em {nome} e região
      </p>
      <h1 class="mt-3 max-w-2xl font-display text-[32px] leading-tight text-areia md:text-[50px]">
        Equipamentos profissionais para cozinha em {nome}
      </h1>
      <p class="mt-4 max-w-xl font-sans text-[15px] leading-relaxed text-areia/90 md:text-lg">
        {cidade.data.heroTexto}
      </p>

      <div class="mt-7 flex flex-col gap-3 md:mt-9 md:flex-row md:items-center">
        <BotaoWhatsApp mensagem={mensagemHeroPrimaria} texto="Pedir orçamento no WhatsApp" class="w-full md:w-auto" />
        <BotaoWhatsApp
          mensagem={mensagemHeroSecundaria}
          texto="Receber o catálogo no WhatsApp"
          variante="contorno"
          class="w-full !text-areia !border-aco hover:!bg-white/5 md:w-auto"
        />
      </div>

      {cidade.data.provaRapida.length > 0 && (
        <ul class="mt-8 flex flex-col gap-2 border-t border-white/10 pt-6 md:mt-10 md:flex-row md:gap-8 md:pt-7">
          {cidade.data.provaRapida.map((fato) => (
            <li class="font-sans text-sm text-areia/90">{fato}</li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- 2. RECONHECIMENTO DO PROBLEMA -->
  <section class="relative overflow-hidden bg-papel px-5 py-12 md:px-14 md:py-20">
    {cidade.data.imagemFundo && (
      <>
        <Image
          src={cidade.data.imagemFundo}
          alt=""
          width={1600}
          height={900}
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-navy/80"></div>
      </>
    )}
    <div
      class:list={[
        'prose relative mx-auto max-w-[760px] font-sans text-[15px] leading-relaxed md:text-base',
        cidade.data.imagemFundo ? 'text-areia' : 'text-aco',
      ]}
    >
      <Content />
    </div>
  </section>

  <!-- 3. CATEGORIAS -->
  <section class="bg-papel px-5 pb-12 md:px-14 md:pb-16">
    <div class="mx-auto max-w-[1440px]">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs">
        Catálogo
      </p>
      <h2 class="mt-3 max-w-[680px] font-display text-[26px] leading-[1.15] text-navy md:mt-4 md:text-[38px]">
        Linhas disponíveis para {nome}
      </h2>

      <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-10 md:grid-cols-3 md:gap-6">
        {categorias.map((categoria) => (
          <div class="flex flex-col gap-3 rounded-md border border-cinza/30 bg-papel p-5">
            <a href={`/tramontina/${categoria.id}`} class="font-sans text-[16px] font-bold text-navy">
              {categoria.data.nome}
            </a>
            <p class="font-sans text-sm leading-relaxed text-aco">{categoria.data.descricao}</p>
            <a
              href={linkWhatsApp(mensagemCategoria(categoria.data.nome))}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto font-sans text-[13px] font-semibold text-[var(--color-accent)]"
            >
              Perguntar sobre {categoria.data.nome} →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. PRODUTOS EM DESTAQUE -->
  {produtosDestaque.length > 0 && (
    <section class="bg-papel px-5 py-12 md:px-14 md:py-16">
      <div class="mx-auto max-w-[1440px]">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs">
          Produtos em destaque
        </p>
        <h2 class="mt-3 max-w-[680px] font-display text-[26px] leading-[1.15] text-navy md:mt-4 md:text-[38px]">
          Selecionados para operações em {nome}
        </h2>
        <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-10 md:grid-cols-3 md:gap-6">
          {produtosDestaque.map((produto) => <CardProduto produto={produto} />)}
        </div>
      </div>
    </section>
  )}

  <!-- BLOCOS (editáveis por cidade — ver Keystatic; por padrão inclui o grid de representadas) -->
  {blocos.map((bloco) => <BlocoRenderer bloco={bloco} />)}

  <!-- 5. COMO FUNCIONA -->
  <section class="bg-areia px-5 py-12 md:px-14 md:py-16">
    <div class="mx-auto max-w-[1440px]">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs">
        Como funciona
      </p>
      <h2 class="mt-3 max-w-[640px] font-display text-[26px] leading-[1.15] text-navy md:mt-4 md:text-[38px]">
        Do WhatsApp à sua cozinha equipada
      </h2>
      <div class="mt-8 flex flex-col gap-3 md:mt-12 md:flex-row md:gap-5">
        {comoFunciona.map((passo) => (
          <div class="flex-1 rounded-md border border-cinza/25 p-5 md:p-8">
            <span class="font-mono text-xs font-semibold text-navy">{passo.numero}</span>
            <h3 class="mt-2.5 font-sans text-[16.5px] font-bold text-navy md:mt-3.5 md:text-[19px]">
              {passo.titulo}
            </h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-navy/80 md:mt-3.5">{passo.descricao}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. OBJEÇÕES / FAQ -->
  {cidade.data.faq.length > 0 && (
    <section class="bg-papel px-5 py-12 md:px-14 md:py-16">
      <div class="mx-auto max-w-[760px]">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs">
          Perguntas frequentes
        </p>
        <h2 class="mt-3 font-display text-[26px] leading-[1.15] text-navy md:mt-4 md:text-[38px]">
          Antes de fechar, tire suas dúvidas
        </h2>
        <div class="mt-7 flex flex-col gap-2.5 md:mt-10">
          {cidade.data.faq.map((item) => (
            <details class="group rounded-md border border-cinza/30 bg-papel p-4 md:p-5">
              <summary class="cursor-pointer list-none font-sans text-[15px] font-semibold text-navy md:text-base">
                {item.pergunta}
              </summary>
              <p class="mt-2.5 font-sans text-sm leading-relaxed text-aco">{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7. PROVA SOCIAL -->
  {temProvaSocial && (
    <section class="bg-areia px-5 py-12 md:px-14 md:py-16">
      <div class="mx-auto max-w-[760px] rounded-md border border-cinza/30 bg-papel p-6 md:p-10">
        <p class="font-display text-xl leading-snug text-navy md:text-2xl">
          "{cidade.data.depoimentoTexto}"
        </p>
        <p class="mt-4 font-sans text-sm font-semibold text-navy">
          {cidade.data.depoimentoAutor}
          {cidade.data.depoimentoEstabelecimento && (
            <span class="font-normal text-aco"> — {cidade.data.depoimentoEstabelecimento}</span>
          )}
        </p>
      </div>
    </section>
  )}

  <!-- 8. CTA FINAL (âncora navy 2/2) -->
  <section class="border-t border-white/12 bg-navy px-5 py-11 text-center md:px-14 md:py-16">
    <div class="mx-auto flex max-w-[1440px] flex-col items-center gap-4 md:gap-5.5">
      <h2 class="font-display text-[26px] text-areia md:text-4xl">Pronto para equipar sua cozinha em {nome}?</h2>
      <p class="font-sans text-sm leading-relaxed text-areia/90 md:max-w-[460px] md:text-[15.5px]">
        Fale com a Prisma pelo WhatsApp e receba um orçamento personalizado para o seu negócio.
      </p>
      <BotaoWhatsApp mensagem={mensagemCtaFinal} texto="Pedir orçamento no WhatsApp" class="w-full md:w-auto" />
    </div>
  </section>

  <!-- 9. OUTRAS CIDADES -->
  {outrasCidades.length > 0 && (
    <section class="bg-papel px-5 py-12 md:px-14 md:py-16">
      <div class="mx-auto max-w-[1440px]">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-cinza md:text-xs">
          Também atendemos
        </p>
        <ul class="mt-5 flex flex-wrap gap-3 md:mt-7">
          {outrasCidades.map((outra) => (
            <li>
              <a
                href={`/${outra.id}`}
                class="inline-flex items-center gap-2 rounded border border-cinza/30 bg-papel px-5 py-3 font-sans text-[15px] font-semibold text-navy transition-colors hover:border-[var(--color-accent)]"
              >
                {outra.data.nome} - {outra.data.estado}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>
