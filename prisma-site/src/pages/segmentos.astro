---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CardSegmento from '../components/CardSegmento.astro';

const segmentos = (await getCollection('segmentos', ({ data }) => data.ativa)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---

<Layout
  title="Segmentos | Prisma Equipamentos"
  description="Segmentos atendidos pela Prisma Equipamentos: restaurantes, hotéis, resorts, buffets e outras operações profissionais de gastronomia."
>
  <div class="mx-auto max-w-[1440px] px-5 py-10 md:px-14 md:py-16">
    <h1 class="font-display text-[32px] leading-tight text-navy md:text-[46px]">Segmentos atendidos</h1>
    <p class="mt-3 max-w-2xl font-sans text-[15px] leading-relaxed text-aco md:text-lg">
      Equipamos operações de todos os portes, dos pequenos estabelecimentos às grandes indústrias.
    </p>

    <div class="mt-8 flex flex-col gap-3 md:mt-12 md:flex-row md:flex-wrap">
      {segmentos.map((segmento) => (
        <div class="md:w-[calc(25%-18px)]">
          <CardSegmento segmento={segmento} />
        </div>
      ))}
    </div>
  </div>
</Layout>
