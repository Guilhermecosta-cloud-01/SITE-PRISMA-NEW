---
import Layout from '../layouts/Layout.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';

const mensagem = 'Olá! Vi a página Sobre no site e queria saber mais sobre a Prisma Equipamentos.';
---

<Layout
  title="Sobre | Prisma Equipamentos"
  description="Conheça a Prisma Equipamentos, representante autorizado Tramontina Hospitality no interior de São Paulo."
>
  <div class="mx-auto max-w-3xl px-5 py-10 md:px-14 md:py-16">
    <h1 class="font-display text-[32px] leading-tight text-navy md:text-[46px]">Sobre a Prisma Equipamentos</h1>

    <!-- EXEMPLO — substituir por conteúdo real -->

    <div class="mt-8 flex flex-col gap-7">
      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">Quem somos</h2>
        <p class="mt-2 font-sans text-[15px] leading-relaxed text-aco">
          TODO: história real da Prisma Equipamentos.
        </p>
      </div>

      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">
          Representação Tramontina Hospitality
        </h2>
        <p class="mt-2 font-sans text-[15px] leading-relaxed text-aco">
          TODO: texto real sobre a representação autorizada e a região de atuação.
        </p>
      </div>

      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">
          Segmentos atendidos
        </h2>
        <p class="mt-2 font-sans text-[15px] leading-relaxed text-aco">
          TODO: lista real de segmentos (restaurantes, bares, hotéis, resorts, padarias, cozinhas industriais).
        </p>
      </div>

      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[1.2px] text-cinza">Contato</h2>
        <p class="mt-2 font-sans text-[15px] leading-relaxed text-aco">
          TODO: informações reais de contato, endereço e horário de atendimento.
        </p>
      </div>
    </div>

    <div class="mt-8">
      <BotaoWhatsApp mensagem={mensagem} texto="Falar no WhatsApp" />
    </div>
  </div>
</Layout>
