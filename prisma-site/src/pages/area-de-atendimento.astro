---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { NUMERO } from '../lib/whatsapp';

const cidades = (await getCollection('cidades'))
  .filter((cidade) => cidade.data.ativa)
  .sort((a, b) => a.data.nome.localeCompare(b.data.nome));
---

<Layout
  title="Área de atendimento | Prisma Equipamentos"
  description="Cidades atendidas pela Prisma Equipamentos no interior de São Paulo. Busque sua cidade ou peça um orçamento direto pelo formulário."
>
  <section class="bg-navy-800 px-5 py-12 md:px-14 md:py-16">
    <div class="mx-auto max-w-[1440px]">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[1.2px] text-[#8FA8C1] md:text-xs">
        Área de atendimento
      </p>
      <h1 class="mt-3 max-w-2xl font-display text-[32px] leading-tight text-cream md:text-[46px]">
        Cidades atendidas no interior de São Paulo
      </h1>
      <p class="mt-4 max-w-xl font-sans text-[15px] leading-relaxed text-[#B9C8D6] md:text-lg">
        Busque sua cidade abaixo ou peça um orçamento direto — mesmo que sua cidade ainda não esteja na lista, a
        gente atende.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-[1440px] px-5 py-10 md:px-14 md:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_380px] md:gap-14">
      <div>
        <label class="block font-mono text-xs font-semibold uppercase tracking-[1.2px] text-[#6B7F94]" for="busca-cidade">
          Buscar cidade
        </label>
        <input
          id="busca-cidade"
          type="text"
          placeholder="Digite o nome da sua cidade..."
          class="mt-2.5 w-full rounded border border-cream-border bg-white px-4 py-3 font-sans text-[15px] text-navy-800 outline-none focus:border-[var(--color-accent)]"
          autocomplete="off"
        />

        <ul id="lista-cidades" class="mt-6 flex flex-wrap gap-3">
          {cidades.map((cidade) => (
            <li data-nome={cidade.data.nome.toLowerCase()}>
              <a
                href={`/${cidade.id}`}
                class="inline-flex items-center gap-2 rounded border border-cream-border bg-white px-5 py-3 font-sans text-[15px] font-semibold text-navy-800 transition-colors hover:border-[var(--color-accent)]"
              >
                {cidade.data.nome} - {cidade.data.estado}
              </a>
            </li>
          ))}
        </ul>

        <p id="sem-resultado" class="mt-6 hidden font-sans text-sm text-[#5C6B7A]">
          Não encontramos sua cidade na lista — preencha o formulário ao lado que a gente confirma o atendimento
          pelo WhatsApp.
        </p>
      </div>

      <div class="h-fit rounded-md border border-cream-border bg-white p-6 md:p-7">
        <h2 class="font-sans text-lg font-bold text-navy-800">Pedir orçamento</h2>
        <p class="mt-1.5 font-sans text-sm text-[#5C6B7A]">
          Preencha os dados e você será direcionado ao WhatsApp com a mensagem já pronta.
        </p>

        <form id="form-atendimento" class="mt-5 flex flex-col gap-4">
          <div>
            <label class="block font-sans text-[13px] font-semibold text-navy-800" for="nome">Nome</label>
            <input
              id="nome"
              name="nome"
              type="text"
              required
              class="mt-1.5 w-full rounded border border-cream-border px-3.5 py-2.5 font-sans text-[15px] text-navy-800 outline-none focus:border-[var(--color-accent)]"
            />
          </div>
          <div>
            <label class="block font-sans text-[13px] font-semibold text-navy-800" for="cnpj">CNPJ</label>
            <input
              id="cnpj"
              name="cnpj"
              type="text"
              required
              placeholder="00.000.000/0000-00"
              class="mt-1.5 w-full rounded border border-cream-border px-3.5 py-2.5 font-sans text-[15px] text-navy-800 outline-none focus:border-[var(--color-accent)]"
            />
          </div>
          <div>
            <label class="block font-sans text-[13px] font-semibold text-navy-800" for="cidade">Cidade</label>
            <input
              id="cidade"
              name="cidade"
              type="text"
              required
              class="mt-1.5 w-full rounded border border-cream-border px-3.5 py-2.5 font-sans text-[15px] text-navy-800 outline-none focus:border-[var(--color-accent)]"
            />
          </div>
          <button
            type="submit"
            class="mt-2 inline-flex items-center justify-center gap-2 rounded bg-[var(--color-accent)] px-6 py-3.5 font-sans text-[15px] font-semibold text-cream transition-colors hover:bg-[var(--color-accent-hover)]"
          >
            Continuar no WhatsApp
          </button>
        </form>
      </div>
    </div>
  </div>

  <script define:vars={{ numero: NUMERO }}>
    const busca = document.getElementById('busca-cidade');
    const lista = document.getElementById('lista-cidades');
    const semResultado = document.getElementById('sem-resultado');

    busca?.addEventListener('input', () => {
      const termo = busca.value.trim().toLowerCase();
      let algumVisivel = false;
      lista?.querySelectorAll('li').forEach((item) => {
        const nome = item.getAttribute('data-nome') || '';
        const visivel = nome.includes(termo);
        item.classList.toggle('hidden', !visivel);
        if (visivel) algumVisivel = true;
      });
      semResultado?.classList.toggle('hidden', algumVisivel || termo === '');
    });

    const form = document.getElementById('form-atendimento');
    form?.addEventListener('submit', (evento) => {
      evento.preventDefault();
      const dados = new FormData(form);
      const nome = String(dados.get('nome') || '').trim();
      const cnpj = String(dados.get('cnpj') || '').trim();
      const cidade = String(dados.get('cidade') || '').trim();
      const mensagem = `Olá! Meu nome é ${nome}, CNPJ ${cnpj}, sou de ${cidade} e gostaria de um orçamento de equipamentos para cozinha.`;
      window.open(`https://wa.me/${numero}?text=${encodeURIComponent(mensagem)}`, '_blank', 'noopener');
    });
  </script>
</Layout>
