---
interface Props {
  size?: number;
  class?: string;
}

const { size = 16, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 18 18"
  fill="none"
  class={className}
  aria-hidden="true"
>
  <rect x="1" y="2" width="16" height="11" rx="2" fill="currentColor"></rect>
  <polygon points="5,13 5,16.5 8.5,13" fill="currentColor"></polygon>
</svg>
